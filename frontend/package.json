{
  "name": "trpg-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security": "npm run build && node scripts/security-check.mjs && node scripts/xss-check.mjs",
    "security:static": "node scripts/security-check.mjs",
    "security:xss": "node scripts/xss-check.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "iOS >= 13",
    "Android >= 8",
    "not dead"
  ]
}
