# trpg-website 后端环境变量模板
# 用法：
#   本机开发：复制成 backend/.env（settings 启动时自动读；已被 .gitignore 忽略），大多数项留空即可。
#   compose 部署：复制成 deploy/django.env（docker-compose.yml 的 env_file；已被 .gitignore 忽略）逐项填写。
#   两个文件各管各的：不要把 compose 的值（DATABASE_URL 指向 postgres 容器等）放进 backend/.env，会把本机开发弄坏。
# 纪律：真实密钥绝不写进仓库，本文件只放空值与说明。

# ---------------------------------------------------------------------------
# 基础
# ---------------------------------------------------------------------------
# Django 密钥。生产必填，且必须是随机长字符串（可用 `python -c "import secrets;print(secrets.token_urlsafe(50))"` 生成）。
DJANGO_SECRET_KEY=
# 是否开启调试。生产必须为 False（prod 配置里已强制 False，此处只影响 dev）。
DJANGO_DEBUG=
# 允许的 Host，逗号分隔。生产必填，例如：example.com,www.example.com
DJANGO_ALLOWED_HOSTS=
# CSRF 受信任来源（带协议），逗号分隔。例如：https://example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# 后台入口路径，必须以 / 结尾。默认 manage-console/，建议生产改成不易猜的值。
DJANGO_ADMIN_URL=
# 日志级别：DEBUG / INFO / WARNING / ERROR
DJANGO_LOG_LEVEL=

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------
# 数据库连接串。生产用 PostgreSQL：postgres://用户:密码@主机:5432/库名
# 本机开发留空即用 backend/db.sqlite3。
DATABASE_URL=

# ---------------------------------------------------------------------------
# 缓存（allauth 注册/登录限速计数与站点配置单例都依赖它）
# ---------------------------------------------------------------------------
# 留空只在**单进程本机开发**下成立（回落到进程内 locmem）。
# 生产（config.settings.prod）留空会直接 ImproperlyConfigured 拒绝启动，填 locmem/dummy 同样被拒：
# gunicorn 跑 3 个 worker，locmem 每个 worker 一份，注册限速 5/h/ip 会变成实际 15/h/ip，
# 站主在后台改的站级开关也要等 300 秒 TTL 才在别的 worker 生效。
# 一键部署（docker-compose.yml）已内置 redis 服务，并在 django 服务的 environment 里
# 注入 CACHE_URL=redis://redis:6379/1 —— 那里的值优先级高于本文件，改地址请改 compose。
# 自建 Redis 时的写法：redis://主机:6379/1（带密码：redis://:密码@主机:6379/1；TLS 用 rediss://）
CACHE_URL=

# ---------------------------------------------------------------------------
# 邮件（事务性邮件：注册验证、密码重置、通知提醒）
# ---------------------------------------------------------------------------
# 邮件后端。生产用 django.core.mail.backends.smtp.EmailBackend；
# 本机调试可用 django.core.mail.backends.console.EmailBackend。
EMAIL_BACKEND=
# SMTP 主机，例如阿里云 DirectMail：smtpdm.aliyun.com
EMAIL_HOST=
# SMTP 端口：SSL 用 465，STARTTLS 用 80/25/587
EMAIL_PORT=
# SMTP 账号（发信地址）
EMAIL_HOST_USER=
# SMTP 密码 / 授权码
EMAIL_HOST_PASSWORD=
# 是否用 SSL（465 端口填 True）
EMAIL_USE_SSL=
# 是否用 STARTTLS（与 EMAIL_USE_SSL 二选一）
EMAIL_USE_TLS=
# SMTP 超时秒数
EMAIL_TIMEOUT=
# 发件人显示地址，例如：跑团网站 <noreply@example.com>
DEFAULT_FROM_EMAIL=
# 服务器错误告警的发件地址，留空同 DEFAULT_FROM_EMAIL
SERVER_EMAIL=
# 站内通知邮件的主题前缀（allauth 邮件用），例如：[跑团网站]
ACCOUNT_EMAIL_SUBJECT_PREFIX=

# ---------------------------------------------------------------------------
# 注册与登录限速（格式：次数/时间单位/维度，多条用逗号分隔；单位 s/m/h/d，维度 ip 或 key）
# ---------------------------------------------------------------------------
# 注册：同 IP 每小时次数上限，默认 5/h/ip
ACCOUNT_SIGNUP_RATE_LIMIT=
# 登录：默认 30/m/ip
ACCOUNT_LOGIN_RATE_LIMIT=
# 找回密码：默认 20/m/ip,5/m/key
ACCOUNT_RESET_PASSWORD_RATE_LIMIT=

# ---------------------------------------------------------------------------
# DRF 接口限速
# ---------------------------------------------------------------------------
# 匿名访问上限，默认 60/min
THROTTLE_ANON=
# 登录用户上限，默认 300/min
THROTTLE_USER=
# 上传类接口上限，默认 30/hour
THROTTLE_UPLOAD=
# GM 申请上限，默认 5/day
THROTTLE_GM_APPLICATION=
# 改昵称接口上限，默认 10/day（真正的 30 天限制在业务逻辑里）
THROTTLE_NICKNAME_CHANGE=
# 前面有几层「自己可控的」反向代理。限速靠它判断谁是客户端：
#   0 = 直连，只认 REMOTE_ADDR，X-Forwarded-For 一律不信（本机开发用这个）
#   2 = Caddy → Nginx → gunicorn（docker-compose.yml 的生产拓扑，prod.py 默认就是 2）
#   1 = 只有一层 Nginx（自己另配 TLS 终结、不用 compose 里的 caddy 时）
# 设小了：所有人共用一个限速桶，正常用户被误伤。
# 设大了：攻击者伪造 X-Forwarded-For 就能把计数重置，限速形同虚设。
# 改部署拓扑（加 CDN / 多层 LB）时，这两个必须一起改。
DRF_NUM_PROXIES=
ALLAUTH_TRUSTED_PROXY_COUNT=

# ---------------------------------------------------------------------------
# 文件与媒体
# ---------------------------------------------------------------------------
# 媒体根目录绝对路径。留空用 backend/media。容器里一般挂 /app/media。
MEDIA_ROOT=
# 是否用 Nginx 的 X-Accel-Redirect 下发受保护文件。生产 True，本机 False。
USE_X_ACCEL_REDIRECT=
# 与 Nginx internal location 对应的前缀，默认 /media/protected/
X_ACCEL_REDIRECT_PREFIX=
# 头像体积上限（字节），默认 2097152（2 MB）
AVATAR_MAX_BYTES=
# 头像缩放后的最长边（像素），默认 256
AVATAR_MAX_SIDE=
# 上传图片的像素总数上限（宽×高），默认 40000000（4000 万）。
# 体积限制挡不住解压炸弹：几百字节的纯色 PNG 能声称自己有上亿像素。
IMAGE_MAX_PIXELS=
# 请求体内存上限（字节），默认 20971520
DATA_UPLOAD_MAX_MEMORY_SIZE=
# 单文件转落盘阈值（字节），默认 5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=

# ---------------------------------------------------------------------------
# 生产传输安全（只在 config.settings.prod 生效）
# ---------------------------------------------------------------------------
# 是否把 http 强制跳转到 https，默认 True。若 TLS 在更外层终结且已自行跳转，可设 False。
SECURE_SSL_REDIRECT=
# HSTS 秒数，默认 31536000（一年）。首次上线可先设小值验证证书无误。
SECURE_HSTS_SECONDS=
# HSTS 是否包含子域，默认 True
SECURE_HSTS_INCLUDE_SUBDOMAINS=
# 是否申请浏览器 preload，默认 False（提交前想清楚，撤销很慢）
SECURE_HSTS_PRELOAD=

# ---------------------------------------------------------------------------
# docker-compose 用（仅 compose 的 postgres 服务读取，Django 不直接用）
# ---------------------------------------------------------------------------
# PostgreSQL 库名 / 用户 / 密码，需与 DATABASE_URL 一致（主机名固定写 postgres：
# 例如 DATABASE_URL=postgres://trpg:密码@postgres:5432/trpg）。
# 域名、对外端口等 compose 级变量不在这里，在项目根目录 .env（见根目录 .env.example）。
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
