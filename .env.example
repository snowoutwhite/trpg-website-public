# docker-compose 级变量模板（只被 docker-compose.yml 的 ${VAR} 插值读取，Django 不读它）。
# 用法：cp .env.example .env 后按注释填写。容器内 Django 配置在 deploy/django.env（模板 backend/.env.example）；本地开发另用 backend/.env。

# 站点地址，给 Caddy 做 TLS 终结与自动证书：
#   生产：填真实域名，如 example.com（DNS 记录须已指向本机，80/443 公网可达；Caddy 自动向 Let's Encrypt 申请证书）
#   本机部署测试：127.0.0.1（Caddy 用本地 CA 自签，浏览器提示不受信任时点继续即可）
SITE_DOMAIN=127.0.0.1

# Caddy 对外发布的宿主端口。生产用 80/443；本机测试改成 8080/8443 以免占用特权端口、与本机开发服务冲突。
HTTP_PORT=80
HTTPS_PORT=443

# postgres 服务健康检查用的用户名与库名，须与 deploy/django.env 里的 POSTGRES_USER / POSTGRES_DB 一致（默认 trpg）。
POSTGRES_USER=trpg
POSTGRES_DB=trpg
